{
  "name": "lynx-html-renderer",
  "version": "0.6.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./html-parser": {
      "types": "./dist/html-parser.d.ts",
      "import": "./dist/html-parser.js",
      "default": "./dist/html-parser.js"
    },
    "./transform": {
      "types": "./dist/transform/types.d.ts",
      "import": "./dist/transform/types.js",
      "default": "./dist/transform/types.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js",
      "default": "./dist/errors/index.js"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "import": "./dist/styles.js",
      "default": "./dist/styles.js"
    },
    "./utils/node-helpers": {
      "types": "./dist/utils/node-helpers.d.ts",
      "import": "./dist/utils/node-helpers.js",
      "default": "./dist/utils/node-helpers.js"
    },
    "./validate/lynx-node": {
      "types": "./dist/validate/lynx-node.d.ts",
      "import": "./dist/validate/lynx-node.js",
      "default": "./dist/validate/lynx-node.js"
    },
    "./dist/styles.css": "./dist/styles.css",
    "./dist/styles.min.css": "./dist/styles.min.css"
  },
  "scripts": {
    "build": "pnpm build:lib && node scripts/fix-esm-imports.mjs && pnpm generate:css",
    "build:lib": "tsc -p tsconfig.build.json",
    "build-example": "pnpm build && cd example && rspeedy build",
    "check": "biome check --write",
    "dev": "cd example && rspeedy dev",
    "format": "biome format --write",
    "preview": "cd example && rspeedy preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.include='src/**'",
    "coverage:ci": "vitest run --coverage --coverage.include='src/**' --reporter=junit --outputFile=test-report.junit.xml",
    "docs:dev": "rspress dev",
    "docs:build": "rspress build",
    "tag": "git tag v`node -p 'require(\"./package\").version'`",
    "postpublish": "pnpm tag && git push && git push --tags",
    "prepublishOnly": "pnpm build",
    "generate:css": "node scripts/generate-css.mjs"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@lynx-js/react": "^0.115.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.3",
    "@codecov/rspack-plugin": "file:pkg/codecov-rspack-plugin-1.0.0.tgz",
    "@lynx-js/preact-devtools": "^5.0.1-cf9aef5",
    "@lynx-js/qrcode-rsbuild-plugin": "^0.4.3",
    "@lynx-js/react": "^0.115.1",
    "@lynx-js/react-rsbuild-plugin": "^0.12.1",
    "@lynx-js/rspeedy": "^0.12.2",
    "@lynx-js/types": "3.4.11",
    "@rsbuild/plugin-type-check": "1.3.1",
    "@testing-library/jest-dom": "^6.9.0",
    "@types/react": "^18.3.25",
    "@vitest/coverage-v8": "3.2.4",
    "jsdom": "^26.1.0",
    "rspress": "^1.47.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.18.20"
    }
  },
  "dependencies": {
    "htmlparser2": "^10.0.0"
  }
}
