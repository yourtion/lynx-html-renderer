{
  "name": "lynx-html-renderer",
  "version": "1.0.0",
  "description": "A lightweight and extensible renderer that renders HTML strings into Lynx native components.",
  "keywords": [
    "lynx",
    "lynx-js",
    "html",
    "html-renderer",
    "rich-text",
    "renderer",
    "react"
  ],
  "homepage": "https://github.com/yourtion/lynx-html-renderer#readme",
  "bugs": {
    "url": "https://github.com/yourtion/lynx-html-renderer/issues"
  },
  "license": "MIT",
  "author": "Yourtion <yourtion@gmail.com> (https://github.com/yourtion)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourtion/lynx-html-renderer.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./html-parser": {
      "types": "./src/html-parser.ts",
      "import": "./src/html-parser.ts",
      "default": "./src/html-parser.ts"
    },
    "./transform": {
      "types": "./src/transform/types.ts",
      "import": "./src/transform/types.ts",
      "default": "./src/transform/types.ts"
    },
    "./errors": {
      "types": "./src/errors/index.ts",
      "import": "./src/errors/index.ts",
      "default": "./src/errors/index.ts"
    },
    "./styles": {
      "types": "./src/styles.ts",
      "import": "./src/styles.ts",
      "default": "./src/styles.ts"
    },
    "./utils/node-helpers": {
      "types": "./src/utils/node-helpers.ts",
      "import": "./src/utils/node-helpers.ts",
      "default": "./src/utils/node-helpers.ts"
    },
    "./validate/lynx-node": {
      "types": "./src/validate/lynx-node.ts",
      "import": "./src/validate/lynx-node.ts",
      "default": "./src/validate/lynx-node.ts"
    },
    "./dist/styles.css": "./dist/styles.css",
    "./dist/styles.min.css": "./dist/styles.min.css"
  },
  "scripts": {
    "build": "pnpm build:lib && node scripts/fix-esm-imports.mjs && pnpm generate:css",
    "build:lib": "tsc -p tsconfig.build.json",
    "build-example": "pnpm build && cd example && rspeedy build",
    "check": "biome check",
    "check:fix": "biome check --write",
    "dev": "cd example && rspeedy dev",
    "format": "biome format --write",
    "preview": "cd example && rspeedy preview",
    "test": "vitest run",
    "test:perf": "vitest run tests/performance",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tests/types/tsconfig.json",
    "coverage": "vitest run --coverage --coverage.include='src/**'",
    "coverage:ci": "vitest run --coverage --coverage.include='src/**' --reporter=junit --outputFile=test-report.junit.xml",
    "docs:dev": "rspress dev",
    "docs:build": "rspress build",
    "prepublishOnly": "pnpm build",
    "generate:css": "node scripts/generate-css.mjs"
  },
  "files": [
    "src",
    "dist/styles.css",
    "dist/styles.min.css"
  ],
  "peerDependencies": {
    "@lynx-js/react": "^0.126.2",
    "@lynx-js/types": "^4.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.3",
    "@codecov/rspack-plugin": "file:pkg/codecov-rspack-plugin-1.0.0.tgz",
    "@lynx-js/preact-devtools": "^5.0.1-cf9aef5",
    "@lynx-js/qrcode-rsbuild-plugin": "0.7.3",
    "@lynx-js/react": "0.126.2",
    "@lynx-js/react-rsbuild-plugin": "0.20.3",
    "@lynx-js/rspeedy": "0.18.0",
    "@lynx-js/types": "4.3.0",
    "@rsbuild/plugin-type-check": "1.6.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@types/react": "^18.3.25",
    "@vitest/coverage-v8": "3.2.4",
    "jsdom": "^26.1.0",
    "rspress": "^1.47.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "@rsbuild/core": "2.2.11",
    "@rspack/core": "2.2.8",
    "postcss": "8.5.29"
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "htmlparser2": "^10.0.0"
  },
  "pnpm": {
    "overrides": {
      "@rsbuild/core@^2": "2.2.11",
      "@rspack/core@^2": "2.2.8",
      "postcss": "8.5.29"
    }
  }
}
