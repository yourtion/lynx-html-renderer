{
  "buildCommand": "npx -y pnpm@10.26.2 run build-example",
  "outputDirectory": "example/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/",
      "destination": "/html/showcase.html"
    }
  ],
  "headers": [
    {
      "source": "/:bundle.lynx.bundle",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
